<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 11+ hides other packages unless declared; flutter_tts needs to
         see the device's text-to-speech engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
